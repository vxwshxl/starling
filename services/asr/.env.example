# Reference for every setting config.py reads. Everything here already has a
# working default, so none of it is required.
#
# NOTE: nothing in this repo loads a .env file -- there is no python-dotenv and
# uvicorn is not started with --env-file. Copying this to .env does nothing on
# its own. To override, export the variable, or put it inline in the command:
#   STARLING_TTS_STEPS=4 pnpm dev:api

# Torch device. This machine is Apple Silicon -> "mps". Never "cuda".
STARLING_DEVICE=mps

# Which ASR backend implementation to use. See asr_backends.py.
# "mlx-whisper" today; "indic-conformer" is the planned phase-2 swap.
STARLING_ASR_BACKEND=mlx-whisper

# Whisper weights, in MLX format. Downloaded from the HF hub on FIRST USE
# (~3 GB) and cached in ~/.cache/huggingface. Flip to the -turbo repo below
# if large-v3 is too slow or too heavy to sit alongside OmniVoice.
#   mlx-community/whisper-large-v3-turbo
STARLING_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# OmniVoice checkpoint. Also downloads on first use.
STARLING_TTS_MODEL=k2-fsa/OmniVoice

# Answering model (English) and translator (English <-> 22 Indian languages).
# ~1.8 GB and ~2.6 GB respectively, downloaded on first use.
STARLING_LLM_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
STARLING_TRANSLATE_MODEL=mlx-community/sarvam-translate-mlx-4bit

# OmniVoice denoising steps. Cost is LINEAR in this, and the audio is real at
# every setting (measured, one 5.7 s utterance):
#   32 -> 138.6 s   16 -> 68.0 s   8 -> 34.3 s   4 -> 17.1 s
# Drop to 4 if the demo needs speed over fidelity. Judge by ear, not by RMS.
STARLING_TTS_STEPS=8

# Where synthesis runs by default. The UI toggle overrides this per request.
#   local  this CPU. Clones the speaker's voice, stays offline, ~6x real time.
#   modal  a serverless GPU. ~3 s warm (~40 s cold), but it CANNOT clone and
#          the reply text leaves the machine.
STARLING_TTS_BACKEND=local
MODAL_TTS_URL=https://bodookhrang--omnivoice-tts-omnivoicetts-tts.modal.run

# API server
STARLING_HOST=127.0.0.1
STARLING_PORT=8000

# Gradio debug UI
STARLING_LAB_PORT=7860
