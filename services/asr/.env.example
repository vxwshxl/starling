# Copy to .env and edit. Everything here has a working default in config.py.

# Torch device. This machine is Apple Silicon -> "mps". Never "cuda".
STARLING_DEVICE=mps

# Which ASR backend implementation to use. See asr_backends.py.
# "mlx-whisper" today; "indic-conformer" is the planned phase-2 swap.
STARLING_ASR_BACKEND=mlx-whisper

# Whisper weights, in MLX format. Downloaded from the HF hub on FIRST USE
# (~3 GB) and cached in ~/.cache/huggingface. Flip to the -turbo repo below
# if large-v3 is too slow or too heavy to sit alongside OmniVoice.
#   mlx-community/whisper-large-v3-turbo
STARLING_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# OmniVoice checkpoint. Also downloads on first use.
STARLING_TTS_MODEL=k2-fsa/OmniVoice

# API server
STARLING_HOST=127.0.0.1
STARLING_PORT=8000

# Gradio debug UI
STARLING_LAB_PORT=7860
